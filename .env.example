# ---------------------------------------------------------------------------
# SC6107 Group Project - Member 1 (VRF + Treasury Infrastructure)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Sepolia testnet RPC -----------------------------------------------------
# An HTTPS endpoint for the Sepolia network (Alchemy / Infura / public RPC).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# --- Deployer key ------------------------------------------------------------
# Private key of the account that deploys the contracts and pays gas.
# Use a throwaway testnet key only. Must be 0x-prefixed.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# --- Chainlink VRF v2.5 subscription ----------------------------------------
# Create a subscription at https://vrf.chain.link (Sepolia), fund it with
# LINK, and paste the numeric subscription id here. Required by HelperConfig
# for any Sepolia deployment.
SUBSCRIPTION_ID=0

# --- Etherscan (optional, for `forge verify-contract`) ----------------------
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
